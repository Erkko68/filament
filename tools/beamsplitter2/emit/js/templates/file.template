{{define "file"}}// This file has been generated by beamsplitter
{{range .Includes}}
#include <{{.}}>
{{- end}}
#include "../jsbindings_helpers.h"

#include <emscripten.h>
#include <emscripten/bind.h>

#include <string>
#include <vector>

using namespace emscripten;
using namespace filament;

{{with .Opaque -}}
// Filament keeps the destructor of everything the engine owns to itself, so
// embind has to be told, once per class, that it cannot delete one.
namespace emscripten {
    namespace internal {
{{- range .}}
        template<> void raw_destructor<{{.}}>({{.}}* ptr) {}
{{- end}}
    }
}

{{end -}}
EMSCRIPTEN_BINDINGS({{.Symbol}}) {
{{range .Classes}}
{{template "class" .}}
{{- end}}
{{- range .Enums}}
{{template "enum" .}}
{{- end}}
{{- range .Structs}}
{{template "struct" .}}
{{- end}}
{{- range .Arrays}}
{{template "array" .}}
{{- end}}
{{- with .Handwritten}}{{template "handwritten" .}}{{end}}
} // EMSCRIPTEN_BINDINGS
{{end}}
